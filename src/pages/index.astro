---
import Base from '../layouts/Base.astro';
import {
  aliasText,
  archive,
  countBy,
  curated,
  href,
  indexTotal,
  manifest,
  nationOptions,
  PAGE_SIZE,
  pendingCount,
  searchKey,
} from '../lib/data';

const total = archive.length;
const counts = {
  horse: countBy('horse'),
  race: countBy('race'),
  jockey: countBy('jockey'),
  trainer: countBy('trainer'),
};

// 首屏 = 第 1 页：默认落在「马匹」栏，所以 SSR 输出的是马匹集合的前 PAGE_SIZE 条。
// 客户端 view 用同一条规则（rows.json 按序过滤 f === 'horse'）算出来，两边逐条相同，
// 翻页时才不会和首屏重叠或跳行。
const horseRows = archive.filter((r) => r.filter === 'horse');
const horseTotal = horseRows.length;
const firstRows = horseRows.slice(0, PAGE_SIZE);
const pageTotal = Math.max(1, Math.ceil(horseTotal / PAGE_SIZE));
const nats = nationOptions();

const qkey = (r: (typeof archive)[number]) =>
  `${searchKey(r.names)} ${r.country} ${r.cc}`.toLowerCase();
---

<Base title="名称档案" nav="archive" narrow>
  <div class="sec">
    全部名称 · <span class="en">NAMES</span>
    <span class="sec-right">
      共 {total} 条<span class="sec-more"
        >· {counts.horse} 匹马 / {counts.race} 场赛事 / {counts.jockey} 位骑手 / {counts.trainer} 位练马师</span
      >
    </span>
  </div>

  <p class="lead">
    一行一条名档：左边是<b>原文</b>（外文写法），右边是<b>港译</b>——中文主名。
    英文只在和原文不同时出现（罗马字的还原写法），简体只是港译的繁简转写，也同样只在有差异时跟一行。
    缺哪一栏就空着，不猜、不补；自译与简称在详情页。
  </p>

  <div class="searchrow">
    <div class="sbox">
      <input
        id="q"
        type="search"
        autocomplete="off"
        placeholder="查原文 / 英文 / 港译 / 简体 / 自译 / 简称"
        aria-label="搜索名称"
      />
    </div>
    <select id="field" aria-label="检索字段">
      <option value="all">全部字段</option>
      <option value="name">只查名称（不查血统）</option>
      <option value="o">原文</option>
      <option value="e">英文</option>
      <option value="h">港译</option>
      <option value="s">简体</option>
      <option value="w">自译</option>
      <option value="a">简称</option>
      <option value="父">父</option>
      <option value="母">母</option>
      <option value="母父">母父</option>
      <option value="父父">父父</option>
    </select>
    <select id="nat" aria-label="按马匹国籍筛选">
      <option value="">全部国籍</option>
      {nats.map((n) => <option value={n.code} data-n={n.count}>{n.cn} {n.code}（{n.count}）</option>)}
    </select>
    <span class="searchhint">空格分隔多个词（须同时命中）· 试试 巧繡 · 巧绣 · M.傲 · Embroidery · マイル · JPN · 父名</span>
  </div>

  <div class="seg" id="seg" role="group" aria-label="按类型筛选">
    <button aria-pressed="false" data-kind="all">全部 <b>{total}</b></button>
    <button aria-pressed="true" data-kind="horse">马匹 <b>{counts.horse}</b></button>
    <button aria-pressed="false" data-kind="race">赛事 <b>{counts.race}</b></button>
    <button aria-pressed="false" data-kind="jockey">骑手 <b>{counts.jockey}</b></button>
    <button aria-pressed="false" data-kind="trainer">练马师 <b>{counts.trainer}</b></button>
  </div>

  <div class="card names">
    <div class="tblwrap">
    <table data-total={total}>
      <thead>
        <tr>
          <th class="th-k">分类</th>
          <th class="th-m">原文<span class="th2">英文</span></th>
          <th class="th-h">港译<span class="th2">简体</span></th>
        </tr>
      </thead>
      <tbody id="rows">
        {
          firstRows.map((r) => {
            const alias = aliasText(r.names);
            const others = [
              r.names.own && { l: '自译', v: r.names.own },
              alias && { l: '简称', v: alias },
            ].filter(Boolean) as { l: string; v: string }[];
            const enDiff = r.names.en && r.names.en !== r.names.original;
            const scDiff = r.names.sc && r.names.sc !== r.names.hk;
            return (
              <tr data-kind={r.filter} data-cc={r.cc} data-uid={r.uid} data-q={qkey(r)}>
                <td class:list={['c-kind', `k-${r.filter}`]}>
                  <span class="ktxt">{r.kind_cn}</span>
                  {r.cc && <span class="cc">{r.cc}</span>}
                </td>
                <td class:list={['c-main', !r.names.original && 'is-empty']}>
                  <span class="ncell">
                    <a
                      href={href(r.path)}
                      class="ncell-main ncell-go"
                      title={r.names.original || undefined}
                    >
                      {r.names.original || '—'}
                    </a>
                    <button
                      type="button"
                      class="ncell-sub cp"
                      data-copy={r.names.en || ''}
                      data-l="英文"
                      aria-label={`复制英文 ${r.names.en || ''}`}
                      title="点击复制英文"
                      hidden={!enDiff}
                    >
                      {r.names.en || ''}
                    </button>
                  </span>
                </td>
                <td class="c-hk">
                  <span class="hkrow">
                    <span class="ncell ncell-hk">
                      <button
                        type="button"
                        class="ncell-main cp"
                        data-copy={r.names.hk || ''}
                        aria-label={`复制港译 ${r.names.hk || ''}`}
                        title="点击复制港译"
                      >
                        {r.names.hk || '—'}
                      </button>
                      <button
                        type="button"
                        class="ncell-sub ncell-sc cp"
                        data-copy={r.names.sc || ''}
                        data-l="简体"
                        aria-label={`复制简体 ${r.names.sc || ''}`}
                        title="点击复制简体"
                        hidden={!scDiff}
                      >
                        {r.names.sc || ''}
                      </button>
                    </span>
                    {r.status === '已校订' && (
                      <span class="kk" title="已校订">✓</span>
                    )}
                  </span>
                  {others.length > 0 && (
                    <span class="ncell-other">
                      {others.map((o, i) => (
                        <>
                          {i > 0 && <i class="odot">·</i>}
                          <span class="olab">{o.l}</span>
                          <button
                            type="button"
                            class="cp"
                            data-copy={o.v}
                            aria-label={`复制${o.l} ${o.v}`}
                            title={`点击复制${o.l}`}
                          >
                            {o.v}
                          </button>
                        </>
                      ))}
                    </span>
                  )}
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
    <div id="nores" class="nores" hidden>没有匹配的名称。换一个关键词，或清空搜索框。</div>
    </div>
  </div>

  <div class="pager">
    <span>
      显示 <b id="from">1</b>–<b id="to">{firstRows.length}</b> / <b id="cntTotal">{horseTotal}</b> 条
    </span>
    <span class="pgs">
      <button class="pg" id="pgFirst" disabled>首页</button>
      <button class="pg" id="pgPrev" disabled>上一页</button>
      <span class="pgn">第 <b id="pageN">1</b> / <b id="pageT">{pageTotal}</b> 页</span>
      <button class="pg" id="pgNext">下一页</button>
      <button class="pg" id="pgLast">末页</button>
    </span>
  </div>

  <div class="srcnote">
    每页 {PAGE_SIZE} 条 · 索引入库 {indexTotal} 篇公告 · 翻页与搜索都在全量上做（不分繁简、忽略空格）·
    检索字段可选：原文 / 英文 / 港译 / 简体 / 自译 / 简称 / 父 / 母 / 母父 / 父父，关键词按空格切词后须全部命中·
    维护范围：{curated} 匹日本籍马已校订，{pendingCount} 匹其他地区只落不维（保留公告港译与拉丁原名，不生成自译、不接血统）·
    血统与生卒信息已按 JBIS 全量补齐 {manifest.counts.pedigree} / {curated} 匹（每匹三页、10 秒排队，共 22 小时）。
  </div>

  <script>
    const q = document.getElementById('q') as HTMLInputElement;
    const natSel = document.getElementById('nat') as HTMLSelectElement;
    const fieldSel = document.getElementById('field') as HTMLSelectElement;
    const seg = document.getElementById('seg')!;
    const tbody = document.getElementById('rows') as HTMLTableSectionElement;
    const fromEl = document.getElementById('from')!;
    const toEl = document.getElementById('to')!;
    const cntTotal = document.getElementById('cntTotal')!;
    const pageN = document.getElementById('pageN')!;
    const pageT = document.getElementById('pageT')!;
    const pgFirst = document.getElementById('pgFirst') as HTMLButtonElement;
    const pgPrev = document.getElementById('pgPrev') as HTMLButtonElement;
    const pgNext = document.getElementById('pgNext') as HTMLButtonElement;
    const pgLast = document.getElementById('pgLast') as HTMLButtonElement;
    const nores = document.getElementById('nores') as HTMLDivElement;
    const BASE = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
    const dataUrl = (p: string) => BASE + 'data/' + p.replace(/^\/+/, '');
    const PAGE = 200;

    type Row = {
      k: string; uid: string; cn: string; f: string;
      o: string | null; e: string | null; h: string | null; s: string | null; w: string | null;
      a: string[]; c: string; cc: string; st: string; cls: string;
    };

    let kind = 'horse';
    let nat = '';
    /** 检索字段：all 全字段 / name 只查名称 / o 原文 / e 英文 / h 港译 / s 简体 / w 自译 / a 简称 / 父 / 母 / 母父 / 父父 */
    let field = 'all';
    let page = 1;
    /** 名栏目 → 索引里的位掩码（与 s5_export 的 MASK 一一对应） */
    const FIELD_BIT: Record<string, number> = { o: 1, e: 2, h: 4, s: 8, w: 16, a: 32 };
    const PED_FIELDS = new Set(['父', '母', '母父', '父父']);

    /** 全量行（顺序即翻页顺序，来自 rows.json）；首屏不加载，点「下一页」或筛选时才拉 */
    let allRows: Row[] | null = null;
    let rowsP: Promise<void> | null = null;
    /** 名称索引：一个键可以挂多个实体（同名赛事、同名人物），值是列表 */
    let index: Record<string, { kind: string; uid: string; m: number }[]> | null = null;
    /** 血统索引：{父: {种马名: [马 uid…]}}，键在小写归一化后再存一份，键盘输入时不必反复转 */
    let pedIndex: Record<string, Record<string, string[]>> | null = null;
    let indexP: Promise<void> | null = null;
    /** 当前筛选下的全量结果，翻页只切这个数组 */
    let view: Row[] = [];
    /** 并发保护：快速输入时只认最后一次渲染 */
    let seq = 0;

    const esc = (s: string | null | undefined) =>
      (s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    /** 检索归一：小写 + 去空白 + 撇号折叠（O’Brien 与 O'Brien 在索引里是同一个键） */
    const norm = (s: string) =>
      s.toLowerCase().replace(/[\u2018\u2019\u201a\u201b\u2032\u02bc\u02b9`\u00b4]/g, "'").replace(/\s+/g, '');

    /** 可复制的名字：主名用 strong=true，副行（英文/简体）退一档 */
    function cp(cls: string, val: string, label: string, show: boolean) {
      const v = esc(val);
      return (
        `<button type="button" class="${cls} cp" data-copy="${v}" data-l="${label}" ` +
        `aria-label="复制${label} ${v}" title="点击复制${label}"${show && val ? '' : ' hidden'}>${v}</button>`
      );
    }

    function rowHtml(r: Row) {
      const path = (r.k === 'person' ? 'person/' : r.k === 'race' ? 'race/' : 'horse/') + r.uid + '/';
      const alias = r.a.length
        ? r.a.slice(0, 3).join(' · ') + (r.a.length > 3 ? ` +${r.a.length - 3}` : '')
        : '';
      const others = [r.w && { l: '自译', v: r.w }, alias && { l: '简称', v: alias }].filter(
        Boolean
      ) as { l: string; v: string }[];
      const enDiff = r.e && r.e !== r.o;
      const scDiff = r.s && r.s !== r.h;
      return (
        `<tr data-kind="${r.f}" data-cc="${esc(r.cc)}" data-uid="${esc(r.uid)}">` +
        `<td class="c-kind k-${r.f}">` +
        `<span class="ktxt">${esc(r.cn)}</span>` +
        (r.cc ? `<span class="cc">${esc(r.cc)}</span>` : '') +
        `</td>` +
        `<td class="c-main${r.o ? '' : ' is-empty'}">` +
        `<span class="ncell">` +
        `<a href="${BASE}${path}" class="ncell-main ncell-go" title="${esc(r.o || '')}">${esc(r.o || '—')}</a>` +
        cp('ncell-sub', r.e || '', '英文', !!enDiff) +
        `</span></td>` +
        `<td class="c-hk">` +
        `<span class="hkrow">` +
        `<span class="ncell ncell-hk">` +
        cp('ncell-main', r.h || '', '港译', true) +
        cp('ncell-sub ncell-sc', r.s || '', '简体', !!scDiff) +
        `</span>` +
        (r.st === '已校订' ? '<span class="kk" title="已校订">✓</span>' : '') +
        `</span>` +
        (others.length
          ? `<span class="ncell-other">` +
            others
              .map(
                (o, i) =>
                  (i ? '<i class="odot">·</i>' : '') +
                  `<span class="olab">${esc(o.l)}</span>` +
                  `<button type="button" class="cp" data-copy="${esc(o.v)}" aria-label="复制${esc(
                    o.l
                  )} ${esc(o.v)}" title="点击复制${esc(o.l)}">${esc(o.v)}</button>`
              )
              .join('') +
            `</span>`
          : '') +
        `</td>` +
        `</tr>`
      );
    }

    function notice(text: string) {
      tbody.innerHTML = `<tr><td colspan="3" class="dim">${esc(text)}</td></tr>`;
    }

    /** 换页 / 筛选后的重排提示：给 tbody 挂一次 .swapped 让新行淡入，首屏不参与 */
    function flashRows() {
      tbody.classList.remove('swapped');
      void tbody.offsetWidth;
      tbody.classList.add('swapped');
    }

    function ensureRows(quiet = false): Promise<void> {
      if (allRows) return Promise.resolve();
      if (!rowsP) {
        if (!quiet) notice('正在加载全量索引…（约 7 MB，只加载一次）');
        rowsP = fetch(dataUrl('search/rows.json'))
          .then((r) => r.json())
          .then((d) => {
            allRows = d.items as Row[];
          })
          .catch(() => {
            rowsP = null;
            notice('全量索引加载失败，请刷新重试。');
            throw new Error('rows');
          });
      }
      return rowsP;
    }

    function ensureIndex(): Promise<void> {
      if (index) return Promise.resolve();
      if (!indexP) {
        indexP = fetch(dataUrl('search/all.json'))
          .then((r) => r.json())
          .then((d) => {
            index = d.items || {};
            // 血统键名归一化后重建：每个种马名查一次就能命中全部产驹
            const norm2 = (s: string) => norm(s);
            pedIndex = {};
            for (const [role, m] of Object.entries(d.ped || {})) {
              const flat: Record<string, string[]> = {};
              for (const [name, uids] of Object.entries(m as Record<string, string[]>)) {
                const k = norm2(name);
                flat[k] = (flat[k] || []).concat(uids);
              }
              pedIndex[role] = flat;
            }
          })
          .catch(() => {
            indexP = null;
          });
      }
      return indexP;
    }

    /**
     * 关键词 + 国籍命中的全量行（**不含类型过滤**），保持 rows.json 的原顺序。
     * 类型过滤放到 render 里做，一份结果同时喂给 chip 计数和当前列表。
     *
     * 关键词按空格切词，每个词都要命中（AND）；每个词在「选中的名栏」里查，
     * 名栏用索引里的位掩码判定，所以「只查港译」不会把英文名混进来。
     */
    async function buildScoped(): Promise<Row[]> {
      const rows = allRows!;
      const natOk = (r: Row) => !nat || r.cc === nat;
      const raw = q.value.trim();
      if (!raw) return rows.filter(natOk);

      const tokens = raw.split(/\s+/).map(norm).filter(Boolean);
      if (!tokens.length) return rows.filter(natOk);

      await ensureIndex();
      const bit = FIELD_BIT[field] || 0;          // 0 = 不按名栏收窄（all / name）
      const byName = field === 'all' || field === 'name' || !!bit;
      const roles = field === 'all' ? ['父', '母', '母父', '父父'] : PED_FIELDS.has(field) ? [field] : [];

      let hit: Set<string> | null = null;
      for (const t of tokens) {
        const cur = new Set<string>();
        if (byName && index) {
          for (const key in index) {
            if (!key.includes(t)) continue;
            for (const v of index[key]) {
              if (bit && !(v.m & bit)) continue;
              cur.add(`${v.kind}:${v.uid}`);
            }
          }
        }
        for (const role of roles) {
          const m = pedIndex?.[role];
          if (!m) continue;
          for (const name in m) {
            if (!name.includes(t)) continue;
            for (const uid of m[name]) cur.add(`horse:${uid}`);
          }
        }
        // 三字国家码（JPN / ARG）不在名称索引里，全字段下直接按国籍命中
        if (field === 'all' && /^[a-z]{3}$/.test(t)) {
          const code = t.toUpperCase();
          for (const r of rows) if (r.cc === code) cur.add(`${r.k}:${r.uid}`);
        }
        hit = hit ? new Set([...hit].filter((x) => cur.has(x))) : cur;
        if (!hit.size) break;
      }
      const ids = hit || new Set<string>();
      return rows.filter((r) => ids.has(`${r.k}:${r.uid}`) && natOk(r));
    }

    /** chip 上的数字 = 当前关键词 / 国籍 / 字段命中的条数（还没按类型收窄），检索后就变成结果数 */
    function paintChips(scoped: Row[]) {
      const n: Record<string, number> = { all: scoped.length, horse: 0, race: 0, jockey: 0, trainer: 0 };
      for (const r of scoped) n[r.f] = (n[r.f] || 0) + 1;
      seg.querySelectorAll('button').forEach((b) => {
        const k = b.getAttribute('data-kind') || 'all';
        const num = b.querySelector('b');
        if (num) num.textContent = String(n[k] ?? 0);
      });
    }

    function syncUrl() {
      const p = new URLSearchParams();
      const text = q.value.trim();
      if (text) p.set('q', text);
      if (kind !== 'horse') p.set('kind', kind);
      if (field !== 'all') p.set('field', field);
      if (nat) p.set('nat', nat);
      if (page > 1) p.set('page', String(page));
      const qs = p.toString();
      history.replaceState(null, '', location.pathname + (qs ? `?${qs}` : ''));
    }

    async function render(sync = true) {
      const my = ++seq;
      try {
        await ensureRows();
      } catch {
        return;
      }
      if (my !== seq) return;

      const scoped = await buildScoped();
      if (my !== seq) return;
      paintChips(scoped);
      view = kind === 'all' ? scoped : scoped.filter((r) => r.f === kind);
      if (my !== seq) return;

      const pages = Math.max(1, Math.ceil(view.length / PAGE));
      page = Math.min(Math.max(1, page), pages);

      const start = (page - 1) * PAGE;
      const slice = view.slice(start, start + PAGE);
      tbody.innerHTML = slice.map(rowHtml).join('');
      flashRows();

      fromEl.textContent = String(view.length ? start + 1 : 0);
      toEl.textContent = String(start + slice.length);
      cntTotal.textContent = String(view.length);
      pageN.textContent = String(page);
      pageT.textContent = String(pages);
      pgFirst.disabled = pgPrev.disabled = page <= 1;
      pgNext.disabled = pgLast.disabled = page >= pages;
      nores.hidden = view.length > 0;

      if (sync) syncUrl();
    }

    /** 首屏是 SSR 出来的，view 还没建——第一次翻页要先把全量视图算出来，否则会以为总共只有 1 页 */
    async function primeView() {
      if (view.length) return;
      try {
        await ensureRows();
      } catch {
        return;
      }
      const scoped = await buildScoped();
      paintChips(scoped);
      view = kind === 'all' ? scoped : scoped.filter((r) => r.f === kind);
    }

    async function goto(p: number) {
      await primeView();
      const pages = Math.max(1, Math.ceil(view.length / PAGE));
      const next = Math.min(Math.max(1, p), pages);
      if (next === page) return;
      page = next;
      render();
      (tbody.closest('.card') as HTMLElement | null)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // 鼠标落到翻页键上就先拉数据：点下去不用等 7 MB（失败不打扰，点击时还会再提示）
    for (const b of [pgFirst, pgPrev, pgNext, pgLast]) {
      b.addEventListener(
        'mouseenter',
        () => {
          ensureRows(true).catch(() => {});
        },
        { once: true },
      );
    }

    pgFirst.addEventListener('click', () => goto(1));
    pgPrev.addEventListener('click', () => goto(page - 1));
    pgNext.addEventListener('click', () => goto(page + 1));
    pgLast.addEventListener('click', () => goto(Number.MAX_SAFE_INTEGER));

    seg.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b) return;
      kind = b.dataset.kind || 'all';
      page = 1;
      seg.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      render();
    });

    natSel.addEventListener('change', () => {
      nat = natSel.value;
      page = 1;
      // 国籍只对马匹有意义：选了国籍就顺带切到「马匹」，别的类型会筛出空表
      if (nat && kind !== 'horse') {
        kind = 'horse';
        seg.querySelectorAll('button').forEach((x) =>
          x.setAttribute('aria-pressed', String(x.getAttribute('data-kind') === 'horse')),
        );
      }
      render();
    });

    fieldSel.addEventListener('change', () => {
      field = fieldSel.value;
      page = 1;
      // 父/母/母父/父父 只有马匹有：选了血统字段就切到「马匹」
      if (field !== 'all' && field !== 'name' && kind !== 'horse') {
        kind = 'horse';
        seg.querySelectorAll('button').forEach((x) =>
          x.setAttribute('aria-pressed', String(x.getAttribute('data-kind') === 'horse')),
        );
      }
      fieldSel.blur();
      render();
    });

    let timer: number | undefined;
    q.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        page = 1;
        render();
      }, 150);
    });

    // 深链：?q= 关键词、?kind=horse|race|jockey|trainer、?nat=JPN、?page=3，可组合也可分享
    const preset = new URLSearchParams(location.search);
    const preKind = preset.get('kind');
    if (preKind && seg.querySelector(`button[data-kind="${preKind}"]`)) {
      kind = preKind;
      seg.querySelectorAll('button').forEach((x) =>
        x.setAttribute('aria-pressed', String(x.getAttribute('data-kind') === kind)),
      );
    }
    const preNat = preset.get('nat');
    if (preNat) {
      natSel.value = preNat;
      nat = natSel.value;
      // 与下拉行为一致：国籍只对马匹有意义，没指定类型时落到马匹
      if (nat && kind === 'all') {
        kind = 'horse';
        seg.querySelectorAll('button').forEach((x) =>
          x.setAttribute('aria-pressed', String(x.getAttribute('data-kind') === 'horse')),
        );
      }
    }
    const preQ = preset.get('q');
    if (preQ) q.value = preQ;
    const preField = preset.get('field');
    if (preField && fieldSel.querySelector(`option[value="${preField}"]`)) {
      field = preField;
      fieldSel.value = preField;
      if (field !== 'all' && field !== 'name' && kind !== 'horse') {
        kind = 'horse';
        seg.querySelectorAll('button').forEach((x) =>
          x.setAttribute('aria-pressed', String(x.getAttribute('data-kind') === 'horse')),
        );
      }
    }
    const prePage = Number(preset.get('page') || 0);
    if (prePage > 1) page = prePage;

    // SSR 输出的就是「默认状态」（马匹栏 + 无关键词 + 无国籍 + 全字段 + 第 1 页）时，
    // 不必白拉 7 MB 的 rows.json；一旦有任何一个筛选，才去算全量视图。
    const atDefault =
      kind === 'horse' && !nat && field === 'all' && !q.value.trim() && page === 1;
    if (!atDefault) render(false);

    /* ── 点名字复制 ───────────────────────────────────────────
     * 原文是链接（跳详情），其余名字都是按钮：委托到 document，
     * 因为翻页会整块重写 tbody，逐个绑定会失效。
     */
    const tip = document.createElement('div');
    tip.className = 'copytip';
    tip.setAttribute('role', 'status');
    tip.setAttribute('aria-live', 'polite');
    document.body.appendChild(tip);
    let tipT = 0;

    async function writeClipboard(text: string) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        // 非安全上下文（或旧浏览器）没有 clipboard API，退回到隐藏 textarea
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.cssText = 'position:fixed;top:0;left:-9999px;opacity:0';
        document.body.appendChild(ta);
        ta.select();
        let ok = false;
        try {
          ok = document.execCommand('copy');
        } catch {
          ok = false;
        }
        ta.remove();
        return ok;
      }
    }

    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('.cp');
      if (!btn) return;
      const text = (btn.dataset.copy || '').trim();
      if (!text || text === '—') return;
      void writeClipboard(text).then((ok) => {
        if (!ok) {
          tip.textContent = '复制失败，请手动选取';
          tip.classList.add('on');
        } else {
          tip.textContent = `已复制 · ${text.length > 16 ? text.slice(0, 16) + '…' : text}`;
          tip.classList.add('on');
          btn.classList.add('ok');
          setTimeout(() => btn.classList.remove('ok'), 900);
        }
        clearTimeout(tipT);
        tipT = window.setTimeout(() => tip.classList.remove('on'), 1500);
      });
    });
  </script>
</Base>
